<?xml version="1.0" encoding="UTF-8"?>
<!-- BENCH (docs/tasks/2.1.0/13): the CANONICAL benchmarking logging config — part of the
     conditions protocol. WARN console only, NO file sink on the hot path (no rolling-file
     appender at all): logging I/O must not pollute the numbers (the PERF study §9 admitted
     the pre-2026-10-22 JMH numbers ran with TRACE console logging). scripts/run-benchmarks.sh
     passes this file explicitly via -Dlog4j.configurationFile, which makes the protocol
     immune to the suite's own config reshuffles (docs/tasks/2.1.0/01-02). -->
<Configuration>
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <ThresholdFilter level="warn" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.github.xdstorage" level="warn" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>
