<?xml version="1.0" encoding="UTF-8"?>
<!-- O-2 (SRE-OPTIMIZATION-PLAN): append=true (was: log truncated on every start),
     RollingFile with size/count caps (was: unbounded single file, GB-scale in storm runs),
     location overridable via -Dxdstorage.log.file (default: ./xdstorage.log).
     NOTE for embedders: this config ships inside the jar — supply your own log4j2.xml
     (or set log4j.configurationFile) to keep full control of logging. -->
<Configuration>
    <Appenders>
        <RollingFile name="xdstorage" fileName="${sys:xdstorage.log.file:-xdstorage.log}"
                     filePattern="${sys:xdstorage.log.file:-xdstorage.log}.%i" append="true">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <SizeBasedTriggeringPolicy size="50 MB"/>
            <DefaultRolloverStrategy max="3"/>
        </RollingFile>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.github.xdstorage" level="info">
            <AppenderRef ref="xdstorage"/>
        </Logger>
        <Root level="info">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>
